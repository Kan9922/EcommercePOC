    <elementParameter field="MEMO_SQL" name="configuration.dataSet.sqlQuery" value="SELECT&#xD;&#xA;    COUNT(*) AS FACT_ORDERS_COUNT,&#xD;&#xA;    COUNT(DISTINCT ORDER_ID) AS DISTINCT_ORDER_COUNT&#xD;&#xA;FROM ECOMMERCE_POC.CURATED.FACT_ORDERS;"/>
