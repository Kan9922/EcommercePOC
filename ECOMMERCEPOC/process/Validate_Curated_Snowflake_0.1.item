    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="long factOrdersCount = row1.FACT_ORDERS_COUNT.longValueExact();;&#xD;&#xA;long distinctOrderCount = input_row.DISTINCT_ORDER_COUNT.longValueExact();&#xD;&#xA;&#xD;&#xA;System.out.println(&#xD;&#xA;    &quot;Snowflake validation: FACT_ORDERS count = &quot;&#xD;&#xA;    + factOrdersCount&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;System.out.println(&#xD;&#xA;    &quot;Snowflake validation: distinct ORDER_ID count = &quot;&#xD;&#xA;    + distinctOrderCount&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;if (factOrdersCount != 100000) {&#xD;&#xA;    throw new RuntimeException(&#xD;&#xA;        &quot;CURATED validation FAILED: expected FACT_ORDERS row count &quot;&#xD;&#xA;        + &quot;100000, but received &quot; + factOrdersCount&#xD;&#xA;    );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (distinctOrderCount != factOrdersCount) {&#xD;&#xA;    throw new RuntimeException(&#xD;&#xA;        &quot;CURATED validation FAILED: duplicate ORDER_ID values found. &quot;&#xD;&#xA;        + &quot;Rows=&quot; + factOrdersCount&#xD;&#xA;        + &quot;, distinct order IDs=&quot; + distinctOrderCount&#xD;&#xA;    );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;System.out.println(&#xD;&#xA;    &quot;Snowflake FACT_ORDERS validation SUCCESS.&quot;&#xD;&#xA;);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJavaRow_1">
      <column comment="" defaultValue="" key="false" length="18" name="FACT_ORDERS_COUNT" nullable="false" pattern="" precision="0" sourceType="NUMBER" type="id_BigDecimal" originalLength="-1" usefulColumn="true"/>
      <column comment="" defaultValue="" key="false" length="18" name="DISTINCT_ORDER_COUNT" nullable="false" pattern="" precision="0" sourceType="NUMBER" type="id_BigDecimal" originalLength="-1" usefulColumn="true"/>
    </metadata>
