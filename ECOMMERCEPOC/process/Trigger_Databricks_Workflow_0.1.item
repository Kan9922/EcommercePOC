    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="String host = &quot;dbc-8035df0f-ba10.cloud.databricks.com&quot;;&#xD;&#xA;String token = context.databricksToken;&#xD;&#xA;String jobId = &quot;189861365822100&quot;;&#xD;&#xA;&#xD;&#xA;java.net.URL startUrl =&#xD;&#xA;    new java.net.URL(&quot;https://&quot; + host + &quot;/api/2.1/jobs/run-now&quot;);&#xD;&#xA;&#xD;&#xA;java.net.HttpURLConnection startConn =&#xD;&#xA;    (java.net.HttpURLConnection) startUrl.openConnection();&#xD;&#xA;&#xD;&#xA;startConn.setRequestMethod(&quot;POST&quot;);&#xD;&#xA;startConn.setRequestProperty(&quot;Authorization&quot;, &quot;Bearer &quot; + token);&#xD;&#xA;startConn.setRequestProperty(&quot;Content-Type&quot;, &quot;application/json&quot;);&#xD;&#xA;startConn.setDoOutput(true);&#xD;&#xA;startConn.setConnectTimeout(30000);&#xD;&#xA;startConn.setReadTimeout(30000);&#xD;&#xA;&#xD;&#xA;String requestBody = &quot;{\&quot;job_id\&quot;:&quot; + jobId + &quot;}&quot;;&#xD;&#xA;&#xD;&#xA;java.io.OutputStream output = startConn.getOutputStream();&#xD;&#xA;output.write(requestBody.getBytes(&quot;UTF-8&quot;));&#xD;&#xA;output.flush();&#xD;&#xA;output.close();&#xD;&#xA;&#xD;&#xA;int startStatus = startConn.getResponseCode();&#xD;&#xA;&#xD;&#xA;java.io.InputStream startStream;&#xD;&#xA;&#xD;&#xA;if (startStatus >= 400) {&#xD;&#xA;    startStream = startConn.getErrorStream();&#xD;&#xA;} else {&#xD;&#xA;    startStream = startConn.getInputStream();&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;java.io.BufferedReader startReader =&#xD;&#xA;    new java.io.BufferedReader(&#xD;&#xA;        new java.io.InputStreamReader(startStream, &quot;UTF-8&quot;)&#xD;&#xA;    );&#xD;&#xA;&#xD;&#xA;StringBuilder startText = new StringBuilder();&#xD;&#xA;String startLine;&#xD;&#xA;&#xD;&#xA;while ((startLine = startReader.readLine()) != null) {&#xD;&#xA;    startText.append(startLine);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;startReader.close();&#xD;&#xA;&#xD;&#xA;String startResponse = startText.toString();&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;Databricks HTTP status: &quot; + startStatus);&#xD;&#xA;System.out.println(&quot;Databricks response: &quot; + startResponse);&#xD;&#xA;&#xD;&#xA;if (startStatus != 200) {&#xD;&#xA;    throw new RuntimeException(&#xD;&#xA;        &quot;Databricks job could not start. HTTP &quot;&#xD;&#xA;        + startStatus + &quot;: &quot; + startResponse&#xD;&#xA;    );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;int runIdStart = startResponse.indexOf(&quot;\&quot;run_id\&quot;&quot;);&#xD;&#xA;&#xD;&#xA;if (runIdStart &lt; 0) {&#xD;&#xA;    throw new RuntimeException(&#xD;&#xA;        &quot;run_id was not found in Databricks response: &quot;&#xD;&#xA;        + startResponse&#xD;&#xA;    );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;int colonPosition = startResponse.indexOf(&quot;:&quot;, runIdStart);&#xD;&#xA;int commaPosition = startResponse.indexOf(&quot;,&quot;, colonPosition);&#xD;&#xA;&#xD;&#xA;if (commaPosition &lt; 0) {&#xD;&#xA;    commaPosition = startResponse.indexOf(&quot;}&quot;, colonPosition);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;String runId =&#xD;&#xA;    startResponse.substring(colonPosition + 1, commaPosition).trim();&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;Databricks run_id: &quot; + runId);&#xD;&#xA;&#xD;&#xA;boolean completed = false;&#xD;&#xA;boolean succeeded = false;&#xD;&#xA;&#xD;&#xA;for (int attempt = 1; attempt &lt;= 120; attempt++) {&#xD;&#xA;&#xD;&#xA;    Thread.sleep(15000);&#xD;&#xA;&#xD;&#xA;    java.net.URL statusUrl =&#xD;&#xA;        new java.net.URL(&#xD;&#xA;            &quot;https://&quot; + host + &quot;/api/2.1/jobs/runs/get?run_id=&quot; + runId&#xD;&#xA;        );&#xD;&#xA;&#xD;&#xA;    java.net.HttpURLConnection statusConn =&#xD;&#xA;        (java.net.HttpURLConnection) statusUrl.openConnection();&#xD;&#xA;&#xD;&#xA;    statusConn.setRequestMethod(&quot;GET&quot;);&#xD;&#xA;    statusConn.setRequestProperty(&quot;Authorization&quot;, &quot;Bearer &quot; + token);&#xD;&#xA;    statusConn.setRequestProperty(&quot;Content-Type&quot;, &quot;application/json&quot;);&#xD;&#xA;    statusConn.setConnectTimeout(30000);&#xD;&#xA;    statusConn.setReadTimeout(30000);&#xD;&#xA;&#xD;&#xA;    int statusCode = statusConn.getResponseCode();&#xD;&#xA;&#xD;&#xA;    java.io.InputStream statusStream;&#xD;&#xA;&#xD;&#xA;    if (statusCode >= 400) {&#xD;&#xA;        statusStream = statusConn.getErrorStream();&#xD;&#xA;    } else {&#xD;&#xA;        statusStream = statusConn.getInputStream();&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    java.io.BufferedReader statusReader =&#xD;&#xA;        new java.io.BufferedReader(&#xD;&#xA;            new java.io.InputStreamReader(statusStream, &quot;UTF-8&quot;)&#xD;&#xA;        );&#xD;&#xA;&#xD;&#xA;    StringBuilder statusText = new StringBuilder();&#xD;&#xA;    String statusLine;&#xD;&#xA;&#xD;&#xA;    while ((statusLine = statusReader.readLine()) != null) {&#xD;&#xA;        statusText.append(statusLine);&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    statusReader.close();&#xD;&#xA;&#xD;&#xA;    String statusResponse = statusText.toString();&#xD;&#xA;&#xD;&#xA;    System.out.println(&#xD;&#xA;        &quot;Databricks status check &quot; + attempt + &quot;: &quot;&#xD;&#xA;        + statusResponse&#xD;&#xA;    );&#xD;&#xA;&#xD;&#xA;    if (statusCode != 200) {&#xD;&#xA;        throw new RuntimeException(&#xD;&#xA;            &quot;Could not check Databricks run status. HTTP &quot;&#xD;&#xA;            + statusCode + &quot;: &quot; + statusResponse&#xD;&#xA;        );&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    int stateStart = statusResponse.indexOf(&quot;\&quot;state\&quot;:{&quot;);&#xD;&#xA;&#xD;&#xA;    if (stateStart &lt; 0) {&#xD;&#xA;        stateStart = statusResponse.indexOf(&quot;\&quot;state\&quot;: {&quot;);&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    if (stateStart &lt; 0) {&#xD;&#xA;        throw new RuntimeException(&#xD;&#xA;            &quot;Top-level Databricks state was not found: &quot;&#xD;&#xA;            + statusResponse&#xD;&#xA;        );&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    int stateEnd = statusResponse.indexOf(&quot;}&quot;, stateStart);&#xD;&#xA;&#xD;&#xA;    if (stateEnd &lt; 0) {&#xD;&#xA;        throw new RuntimeException(&#xD;&#xA;            &quot;Top-level Databricks state could not be read: &quot;&#xD;&#xA;            + statusResponse&#xD;&#xA;        );&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    String topLevelState =&#xD;&#xA;        statusResponse.substring(stateStart, stateEnd + 1);&#xD;&#xA;&#xD;&#xA;    System.out.println(&#xD;&#xA;        &quot;Top-level Databricks job state: &quot; + topLevelState&#xD;&#xA;    );&#xD;&#xA;&#xD;&#xA;    boolean topLevelTerminated =&#xD;&#xA;        topLevelState.indexOf(&#xD;&#xA;            &quot;\&quot;life_cycle_state\&quot;:\&quot;TERMINATED\&quot;&quot;&#xD;&#xA;        ) >= 0&#xD;&#xA;        || topLevelState.indexOf(&#xD;&#xA;            &quot;\&quot;life_cycle_state\&quot;: \&quot;TERMINATED\&quot;&quot;&#xD;&#xA;        ) >= 0;&#xD;&#xA;&#xD;&#xA;    boolean topLevelSuccess =&#xD;&#xA;        topLevelState.indexOf(&#xD;&#xA;            &quot;\&quot;result_state\&quot;:\&quot;SUCCESS\&quot;&quot;&#xD;&#xA;        ) >= 0&#xD;&#xA;        || topLevelState.indexOf(&#xD;&#xA;            &quot;\&quot;result_state\&quot;: \&quot;SUCCESS\&quot;&quot;&#xD;&#xA;        ) >= 0;&#xD;&#xA;&#xD;&#xA;    boolean topLevelInternalError =&#xD;&#xA;        topLevelState.indexOf(&#xD;&#xA;            &quot;\&quot;life_cycle_state\&quot;:\&quot;INTERNAL_ERROR\&quot;&quot;&#xD;&#xA;        ) >= 0&#xD;&#xA;        || topLevelState.indexOf(&#xD;&#xA;            &quot;\&quot;life_cycle_state\&quot;: \&quot;INTERNAL_ERROR\&quot;&quot;&#xD;&#xA;        ) >= 0;&#xD;&#xA;&#xD;&#xA;    boolean topLevelSkipped =&#xD;&#xA;        topLevelState.indexOf(&#xD;&#xA;            &quot;\&quot;life_cycle_state\&quot;:\&quot;SKIPPED\&quot;&quot;&#xD;&#xA;        ) >= 0&#xD;&#xA;        || topLevelState.indexOf(&#xD;&#xA;            &quot;\&quot;life_cycle_state\&quot;: \&quot;SKIPPED\&quot;&quot;&#xD;&#xA;        ) >= 0;&#xD;&#xA;&#xD;&#xA;    if (topLevelTerminated) {&#xD;&#xA;        completed = true;&#xD;&#xA;        succeeded = topLevelSuccess;&#xD;&#xA;        break;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    if (topLevelInternalError || topLevelSkipped) {&#xD;&#xA;        completed = true;&#xD;&#xA;        succeeded = false;&#xD;&#xA;        break;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (!completed) {&#xD;&#xA;    throw new RuntimeException(&#xD;&#xA;        &quot;Databricks job did not finish within 30 minutes. run_id=&quot;&#xD;&#xA;        + runId&#xD;&#xA;    );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;if (!succeeded) {&#xD;&#xA;    throw new RuntimeException(&#xD;&#xA;        &quot;Databricks job finished unsuccessfully. run_id=&quot;&#xD;&#xA;        + runId&#xD;&#xA;    );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;System.out.println(&#xD;&#xA;    &quot;Databricks workflow completed successfully. run_id=&quot; + runId&#xD;&#xA;);"/>
